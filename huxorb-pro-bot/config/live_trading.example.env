# Huxorb Pro — Live Trading Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials.

# KuCoin API Credentials
# ----------------------
# Get these from: https://www.kucoin.com/account/api
# Permissions needed: General + Trade (NO Futures, NO Margin)
KUCOIN_API_KEY=your_api_key_here
KUCOIN_API_SECRET=your_api_secret_here
KUCOIN_PASSPHRASE=your_api_passphrase_here

# Testnet Mode (use KuCoin sandbox)
# ----------------------------------
# true = use sandbox (fake money)
# false = live trading (REAL money)
KUCOIN_TESTNET=true

# Trading Parameters
# ------------------
SYMBOLS=BTC/USDT,ETH/USDT
STARTING_BALANCE=10000
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_TRADES=2
MAX_TRADES_PER_DAY=3
POLL_INTERVAL_SECONDS=3600

# Dry Run Mode
# ------------
# true = log orders but don't execute
# false = execute real orders
DRY_RUN=true

# Alerts (optional)
# -----------------
# Webhook URL for alerts (Slack, Discord, etc.)
# Leave empty to disable
ALERT_WEBHOOK_URL=

# Daily summary alert time (UTC, HH:MM)
DAILY_SUMMARY_TIME=00:00
