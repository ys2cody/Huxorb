# =============================================================
# HUXORB PRO — Live Trading Configuration TEMPLATE
# =============================================================
# Copy this to .env and fill in your KuCoin credentials.
# NEVER commit .env (it is gitignored).
# =============================================================

# --- KuCoin API Credentials ---
# Get from: https://www.kucoin.com/account/api
# Permissions needed: General + Spot Trade
# DO NOT enable: Futures, Margin, Withdrawals
KUCOIN_API_KEY=your_api_key_here
KUCOIN_API_SECRET=your_api_secret_here
KUCOIN_PASSPHRASE=your_api_passphrase_here

# --- Mode ---
# true = sandbox (fake money) | false = real production trading
KUCOIN_TESTNET=false

# true = log orders without executing | false = real orders
DRY_RUN=false

# --- Trading Universe (Aggressive default: top 20 altcoins) ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,DOT/USDT,POL/USDT,LTC/USDT,NEAR/USDT,UNI/USDT,ATOM/USDT,APT/USDT,FIL/USDT,ARB/USDT,INJ/USDT,OP/USDT

# --- Capital & Risk (Aggressive preset) ---
# STARTING_BALANCE is auto-detected from your live KuCoin USDT balance.
# Uncomment to override (e.g. only allow the bot to use part of your balance).
# STARTING_BALANCE=500
RISK_PER_TRADE_PCT=1.5
MAX_OPEN_TRADES=4
MAX_TRADES_PER_DAY=6
POLL_INTERVAL_SECONDS=3600

# --- Trading Profile (pick one, don't enable both) ---
#
# AGGRESSIVE_MODE: trade more often when BTC macro is bearish.
#   Use in bull markets and mid-cycle corrections. Risky in deep bears.
AGGRESSIVE_MODE=false
#
# BEAR_MODE: mean-reversion only on BTC/ETH, 0.75% risk, 2 max trades.
#   Designed for capital preservation + tiny gains during confirmed bears.
#   Overrides SYMBOLS, RISK_PER_TRADE_PCT, and MAX_OPEN_TRADES.
#   Expected: £1-5/month on £100. Not a route to riches.
BEAR_MODE=false
#
# AUTO_BEAR_MODE_EXIT: automatically turn bear mode OFF when BTC recovers.
#   Exits bear mode when BTC closes above 200-day MA + has golden cross.
#   Bot switches back to your standard symbol list + risk settings.
#   Recommended: true (set-and-forget — bot adapts to market automatically).
AUTO_BEAR_MODE_EXIT=false

# --- Alerts (optional) ---
ALERT_WEBHOOK_URL=
DAILY_SUMMARY_TIME=00:00
